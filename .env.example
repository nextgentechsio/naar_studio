# Copy to .env.local and fill in. Restart the app after any change.

# Replicate API token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Signs login cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Super admin: used ONCE to create the super admin in MongoDB when none exists.
# Afterwards MongoDB is the source of truth (change name/password on the Users page);
# editing these values has no effect.
# Username: 3-32 chars, a-z 0-9 . _ -   Password: at least 8 chars.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# MongoDB: stores admins, users and projects.
# Example Atlas URI: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name (collections "users" and "projects" are created automatically)
MONGODB_DB=ai_studio

# Vercel Blob: input files (reference images, video, audio) upload straight from
# the browser, since Vercel rejects requests over 4.5 MB. Set automatically when
# you connect a PUBLIC Blob store to the project (Vercel → Storage → Blob).
# Leave empty locally to upload through the app server instead.
BLOB_READ_WRITE_TOKEN=
